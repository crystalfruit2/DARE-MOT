# Fairness detector dump — generated output, regenerable via _fairness_detdump.py
_fairness_detdump.out

# ReID feature diagnostic dump — generated output, regenerable via _reid_diag.py
_reid_diag.out

# Ablation sweep raw tracker output — generated, regenerable via _run_ablation.ps1 /
# tools/track.py; the numeric results are recorded in the vault (paper Table IV,
# DARE-MOT-paper-changelog.md), not tracked here.
_ablation/

# Ablation-ladder + gate-sweep + lock-check raw output (tracker logs + _*_scores.txt) —
# generated, regenerable via _run_ablation_ladder.ps1 / _run_gate_sweep_ft.ps1 /
# _run_lock_gate_check.ps1; numbers live in the vault (class-leak-analysis §14-15), keep the scripts.
_ablation_ladder/
_gate_sweep_ft/
_gate_sweep/
_lock_gate_check/
_iou_gate_sweep/
_iou_gate_fine/

# ID-switch review crops — generated diagnostic output, regenerable via _idswitch_extract.py
_idswitch_review/
_ablation_multiseq/

# TrackEval HOTA/AssA scratch harness — GT/tracker data copies are regenerable from
# the ablation results and the shared dataset; keep run_hota.py (the actual script).
_trackeval/gt/
_trackeval/trackers/

# Multi-class HOTA scratch workspace — same pattern as _trackeval/gt|trackers above,
# regenerable via _score_hota_mc.py; keep the script, not the GT/tracker data copies.
_trackeval/_mc_hota_ws/

# Pedestrian-only (class-leak-corrected) ground truth — regenerable via
# _build_ped_gt.py from the raw VisDrone-MOT val annotations; keep the script.
_ped_gt/
/reid_train
/_iou_gate_fine
/_iou_gate_sweep

# Path-1 baseline reference clones (large; vendor only adapter files into baselines/)
_baselines/
_mc_*.log

# CMC warp-SNR gate (G2) decisive experiment — raw residual logs + switch-record
# join output, regenerable via _cmc_residual_pass.py / _cmc_idsw_join.py; keep the
# scripts, numbers live in the vault (experiment-log.md 2026-07-29).
_cmc_residual_logs/
_cmc_gate_decisive/
_cmc_*.log

# Session diagnostic scratch — bulk data emitted by the _<tag>_*.py analysis scripts
# (Round 2/3/4 novelty screening, _verify_* adversarial checks, etc). Same rule as the
# blocks above: KEEP the .py scripts (they back the verdicts and before/after tables),
# IGNORE the regenerable data they emit. All numbers live in the vault
# (Projects/Dare_Mot/experiments/experiment-log.md). Added 2026-09-07 after ~229 MB of
# _r33_* / _verify_* CSVs (one file 72 MB) showed up untracked at repo root.
# Extension globs cover any future diagnostic prefix (_moveX_, _r5_, …).
_*.csv
_*.npy
_*.npz
_*.pkl
_*.parquet
_*.feather
_r33_affines/
_verify_out_*/
_appres_*/

# Preferred home for ALL future diagnostic output (logs, CSVs, dumps, overlay dirs).
# New analysis sessions must write here, not to repo root — keeps `git status` clean
# without needing a new ignore line per diagnostic family. Scripts still live at root
# and are committed normally.
_scratch/
